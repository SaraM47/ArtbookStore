@model AdminDashboardViewModel
@{
    // Use dedicated admin layout 
    Layout = "_AdminLayout";
    // Page title shown in browser tab and header
    ViewData["Title"] = "Dashboard";
}

<!-- Admin dashboard overview page -->
<section class="admin-dashboard">

    <div class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Admin overview</p>
            <h1 class="admin-title">Dashboard</h1>
            <p class="admin-page-lead">
                Track products, orders, revenue and stock status in one calm overview.
            </p>
        </div>

        <a asp-controller="Products"
           asp-action="AdminIndex"
           class="admin-primary-action">
            Manage products
        </a>
    </div>

<!--Metrics grid showing key performance indicators with links to details -->
    <div class="admin-metric-grid">

        <article class="admin-card metric-card">
            <div class="metric-top">
                <span class="metric-icon">
                    <i class="bi bi-box-seam"></i>
                </span>
                <h3>Total products</h3>
            </div>

            <p class="metric-value">@Model.TotalProducts</p>

            <a asp-controller="Products"
               asp-action="AdminIndex"
               class="metric-link">
                View products
                <i class="bi bi-arrow-right"></i>
            </a>
        </article>

        <article class="admin-card metric-card">
            <div class="metric-top">
                <span class="metric-icon">
                    <i class="bi bi-receipt"></i>
                </span>
                <h3>Total orders</h3>
            </div>

            <p class="metric-value">@Model.TotalOrders</p>

            <a asp-controller="Orders"
               asp-action="Index"
               class="metric-link">
                View orders
                <i class="bi bi-arrow-right"></i>
            </a>
        </article>

        <article class="admin-card metric-card">
            <div class="metric-top">
                <span class="metric-icon">
                    <i class="bi bi-cash-stack"></i>
                </span>
                <h3>Total revenue</h3>
            </div>

            <!-- Format revenue as currency -->
            <p class="metric-value">@Model.TotalRevenue.ToString("C")</p>

            <a asp-controller="Orders"
               asp-action="Index"
               class="metric-link">
                View revenue
                <i class="bi bi-arrow-right"></i>
            </a>
        </article>

        <article class="admin-card metric-card metric-warning">
            <div class="metric-top">
                <span class="metric-icon">
                    <i class="bi bi-exclamation-circle"></i>
                </span>
                <h3>Low stock items</h3>
            </div>

            <!-- Show count of low stock products -->
            <p class="metric-value">@Model.LowStockCount</p>

            <a asp-controller="Products"
               asp-action="AdminIndex"
               class="metric-link">
                Check stock
                <i class="bi bi-arrow-right"></i>
            </a>
        </article>

    </div>

    <section class="admin-panel admin-chart-panel">
        <div class="admin-panel-header">
            <div>
                <p class="admin-eyebrow">Revenue</p>
                <h2 class="admin-panel-title">Revenue overview</h2>
            </div>

            <span class="admin-panel-subtitle">Monthly performance</span>
        </div>

        <div class="admin-chart-box">
            <canvas id="revenueChart"></canvas>
        </div>
    </section>

    <script>
        window.revenueLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueLabels));
        window.revenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueData));
    </script>

    <!-- Activity grid showing recent orders and low stock products -->
    <div class="activity-grid">

        <section class="admin-panel">
            <div class="admin-panel-header">
                <div>
                    <p class="admin-eyebrow">Orders</p>
                    <h2 class="admin-panel-title">Recent orders</h2>
                </div>
            </div>

            <div class="activity-list">
                @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                {
                    @foreach (var order in Model.RecentOrders)
                    {
                        var statusClass = order.Status?.ToLowerInvariant() ?? "unknown";

                        <div class="activity-item">
                            <div class="activity-main">
                                <a asp-controller="Orders"
                                   asp-action="Details"
                                   asp-route-id="@order.Id"
                                   class="activity-title">
                                    Order #@order.Id
                                </a>

                                <span class="activity-meta">
                                    @order.TotalAmount.ToString("C")
                                </span>
                            </div>

                            <span class="status-badge @statusClass">
                                @order.Status
                            </span>
                        </div>
                    }
                }
                else
                {
                    <p class="empty-state">No recent orders.</p>
                }
            </div>
        </section>

        <section class="admin-panel">
            <div class="admin-panel-header">
                <div>
                    <p class="admin-eyebrow">Inventory</p>
                    <h2 class="admin-panel-title">Low stock products</h2>
                </div>
            </div>

<!-- List of products that are low in stock with links to edit and restock -->
            <div class="activity-list">
                @if (Model.LowStockProducts != null && Model.LowStockProducts.Any())
                {
                    @foreach (var product in Model.LowStockProducts)
                    {
                        <div class="activity-item">
                            <div class="activity-main">
                                <a asp-controller="Products"
                                   asp-action="Edit"
                                   asp-route-id="@product.Id"
                                   class="activity-title">
                                    @product.Title
                                </a>

                                <span class="activity-meta">
                                    Needs restock
                                </span>
                            </div>

                            <span class="stock-pill">
                                @product.StockQuantity left
                            </span>
                        </div>
                    }
                }
                else
                {
                    <p class="empty-state">No low stock items.</p>
                }
            </div>
        </section>

    </div>

</section>

@section Scripts {

<script>
document.addEventListener("DOMContentLoaded", function () {
    if (typeof Chart === "undefined") return;

    const labels = window.revenueLabels || [];
    const data = window.revenueData || [];

    if (!labels.length) return;

    const canvas = document.getElementById("revenueChart");
    if (!canvas) return;

    const ctx = canvas.getContext("2d");

    new Chart(ctx, {
        type: "bar",
        data: {
            labels: labels,
            datasets: [{
                label: "Monthly Revenue",
                data: data,
                backgroundColor: "#111111",
                borderRadius: 10,
                barThickness: 36
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: "#111111",
                    titleFont: {
                        family: "serif",
                        size: 14
                    },
                    bodyFont: {
                        family: "serif",
                        size: 13
                    },
                    padding: 12
                }
            },
            scales: {
                x: {
                    grid: {
                        display: false
                    },
                    ticks: {
                        color: "#555"
                    }
                },
                y: {
                    beginAtZero: true,
                    grid: {
                        color: "rgba(0,0,0,0.06)"
                    },
                    ticks: {
                        color: "#555"
                    }
                }
            }
        }
    });
});
</script>

}