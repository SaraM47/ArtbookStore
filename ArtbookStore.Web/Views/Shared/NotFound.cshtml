@{
    ViewData["Title"] = "Page Not Found";
}

<div class="text-center mt-5">
    <h2><strong>404 - Page Not Found</strong></h2>

    <p class="mt-3">
        The page you are looking for does not exist.
    </p>

    <a asp-controller="Home"
       asp-action="Index"
       class="sf-btn">
        Return to Home
    </a>
</div>
